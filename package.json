{
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:mobile": "pnpm --dir apps/mobile dev",
    "android": "pnpm --filter mobile android",
    "ios": "pnpm --filter mobile ios",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "turbo": "^2.9.6"
  },
  "pnpm": {
    "patchedDependencies": {
      "expo-updates@29.0.16": "patches/expo-updates@29.0.16.patch"
    }
  },
  "packageManager": "pnpm@8.15.6",
  "name": "with-vite"
}
