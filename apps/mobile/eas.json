{
  "cli": {
    "version": ">= 18.11.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_IS_STORE_BUILD": "true"
      },
      "ios": {
        "credentialsSource": "remote",
        "distribution": "store",
        "autoIncrement": true
      },
      "android": {
        "credentialsSource": "remote",
        "buildType": "app-bundle",
        "autoIncrement": true
      },
      "channel": "production"
    },
    "production-apk": {
      "credentialsSource": "remote",
      "env": {
        "EXPO_PUBLIC_IS_STORE_BUILD": "false"
      },
      "android": {
        "buildType": "apk",
        "autoIncrement": true
      },
      "channel": "production"
    }
  },

  "submit": {
    "production": {}
  }
}
