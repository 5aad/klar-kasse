{
  "cli": {
    "version": ">= 18.11.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_IS_STORE_BUILD": "true"
      },
      "ios": {
        "credentialsSource": "remote",
        "distribution": "store",
        "autoIncrement": true
      },
      "android": {
        "credentialsSource": "remote",
        "gradleCommand": ":app:bundleRelease -PreactNativeArchitectures=arm64-v8a",
        "applicationArchivePath": "android/app/build/outputs/bundle/release/*.aab",
        "autoIncrement": true
      },
      "channel": "production"
    },
    "production-apk": {
      "credentialsSource": "remote",
      "env": {
        "EXPO_PUBLIC_IS_STORE_BUILD": "false"
      },
      "android": {
        "gradleCommand": ":app:assembleRelease -PreactNativeArchitectures=arm64-v8a",
        "applicationArchivePath": "android/app/build/outputs/apk/release/*.apk",
        "autoIncrement": true
      },
      "channel": "production"
    }
  },

  "submit": {
    "production": {}
  }
}
