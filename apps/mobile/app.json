{
  "expo": {
    "name": "Klar Kasse",
    "slug": "klar-kasse",
    "scheme": "klarkasse",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/splash-light-icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-light-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff",
      "dark": {
        "image": "./assets/splash-dark-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#101010"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "de.klasrkasse.app",
      "icon": {
        "light": "./assets/ios-light.png",
        "dark": "./assets/ios-dark.png",
        "tinted": "./assets/ios-tinted.png"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Klar Kasse uses your camera to scan receipts and extract purchase details. For example, point your camera at a supermarket receipt to review items, totals, and spending categories.",
        "NSPhotoLibraryUsageDescription": "Klar Kasse accesses your photo library so you can import an existing receipt image. For example, choose a saved receipt photo to review and add it to your spending records."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-light.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.CAMERA"],
      "package": "de.klasrkasse.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      ["expo-localization"],
      [
        "expo-router",
        {
          "root": "./src/app"
        }
      ],
      [
        "react-native-document-scanner-plugin",
        {
          "cameraPermission": "Allow Klar Kasse to scan receipts."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 24
          }
        }
      ]
    ],
    "extra": {
      "router": {
        "root": "./src/app"
      },
      "eas": {
        "projectId": "9e01ae7e-6ae7-4cbd-b730-95e9fd76fd18"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/9e01ae7e-6ae7-4cbd-b730-95e9fd76fd18",
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    }
  }
}
