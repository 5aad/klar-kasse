# Dependencies installed locally. EAS installs dependencies during the build.
node_modules/

# Expo and Metro local state.
.expo/
.cache/
.metro-health-check*
*.tsbuildinfo

# Generated build output.
dist/
web-build/
build/

# Generated native folders. EAS can generate these from app.json during managed builds.
android/
ios/

# Local secrets and credentials should not be uploaded.
.env
.env.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem

# Logs and OS files.
*.log
npm-debug.*
yarn-debug.*
yarn-error.*
.DS_Store
